PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=realtime_chat
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional local HTTPS for phones. Set both paths to a trusted certificate/key.
# HTTPS_KEY_FILE=certs/laptop-key.pem
# HTTPS_CERT_FILE=certs/laptop-cert.pem
# Optional; defaults to the project's ignored uploads/ directory.
# UPLOADS_DIR=C:\\realtime-chat-uploads
