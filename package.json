{
  "name": "realtime-chat",
  "version": "1.0.0",
  "description": "Real-time chat application with rooms, private messages, typing indicators and message history, built with Express and Socket.IO",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --runInBand --forceExit"
  },
  "keywords": [
    "chat",
    "socket.io",
    "websocket",
    "express",
    "realtime",
    "nodejs",
    "rooms"
  ],
  "author": "Gunjit",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunjit-web/realtime-chat.git"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "multer": "^2.5.0",
    "mysql2": "^3.14.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000
  }
}
